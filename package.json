{
  "name": "prime-archive",
  "version": "1.0.0",
  "description": "A selective record of focused effort and evolving perspective.",
  "main": "index.js",
  "scripts": {
    "generate:contributor-thumbs": "powershell -ExecutionPolicy Bypass -File projects/shared/scripts/generate-contributor-thumbnails.ps1",
    "generate:carousels": "node projects/shared/scripts/generate-project-image-manifests.js",
    "generate:project-html": "node projects/shared/scripts/generate-project-image-html.js",
    "generate:contributors": "node projects/shared/scripts/generate-contributor-sections.js",
    "generate:github-repos": "node projects/shared/scripts/fetch-contributor-github-repos.js",
    "generate:contributor-profiles": "node projects/shared/scripts/generate-contributor-profiles.js",
    "prestart": "npm run generate:contributor-thumbs && npm run generate:carousels && npm run generate:project-html && npm run generate:contributors && npm run generate:github-repos && npm run generate:contributor-profiles",
    "start": "serve ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anand-ps/prime-archive.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/anand-ps/prime-archive/issues"
  },
  "homepage": "https://github.com/anand-ps/prime-archive#readme",
  "devDependencies": {
    "serve": "^14.2.6"
  }
}
